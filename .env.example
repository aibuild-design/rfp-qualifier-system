# Supabase — dashboard + auth. From the project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret n8n sends as `Authorization: Bearer <key>` when POSTing to
# /api/rfps/intake. Generate any random string — this is separate from the
# Supabase service-role key on purpose, so n8n never holds a credential
# broader than "post RFP data."
RFP_INTAKE_API_KEY=
