# Supabase — dashboard + auth. From the project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret n8n sends as `Authorization: Bearer <key>` when POSTing to
# /api/rfps/intake. Generate any random string — this is separate from the
# Supabase service-role key on purpose, so n8n never holds a credential
# broader than "post RFP data."
RFP_INTAKE_API_KEY=

# n8n public API — used to deploy/update the workflow in n8n/ from this repo.
# Not needed to run the app itself.
N8N_API_KEY=
N8N_BASE_URL=

# OpenRouter — the triage/classification model layer. Lives on Caravann's own
# account and key per the SOW; usage-based, not a subscription.
OPENROUTER_API_KEY=
