# Supabase — dashboard + auth. From the project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret n8n sends as `Authorization: Bearer <key>` when POSTing to
# /api/rfps/intake. Generate any random string — this is separate from the
# Supabase service-role key on purpose, so n8n never holds a credential
# broader than "post RFP data."
RFP_INTAKE_API_KEY=

# Postgres — used by scripts/migrate.mjs only, never by the app. The direct
# db.<ref>.supabase.co host is IPv6-only on newer projects, so use the session
# pooler: aws-<n>-<region>.pooler.supabase.com (user postgres.<project-ref>).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432

# n8n public API — used to deploy/update the workflow in n8n/ from this repo.
# Not needed to run the app itself. The N8N_CRED_*_ID vars are written back by
# n8n/deploy.mjs after it creates each credential; n8n's API can't list
# credentials, so without them a redeploy makes duplicates.
N8N_API_KEY=
N8N_BASE_URL=
N8N_CRED_BIDDESK_ID=
N8N_CRED_OPENROUTER_ID=

# OpenRouter — the triage/classification model layer. Lives on Caravann's own
# account and key per the SOW; usage-based, not a subscription.
OPENROUTER_API_KEY=
